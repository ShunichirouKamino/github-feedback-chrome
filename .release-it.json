{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "git": {
    "tagName": "v${version}",
    "tagAnnotation": "github-feedback ${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "commitMessage": "chore(release): ${version}",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "github-feedback ${version}",
    "assets": ["dist/*.zip"]
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["npm run verify"],
    "after:bump": ["node scripts/sync-version.js ${version}", "npm run package"]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nGenerated by release-it from Conventional Commits. Do not edit by hand."
    }
  }
}
